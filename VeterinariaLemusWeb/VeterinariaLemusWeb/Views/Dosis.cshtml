@model DosisViewModel
@{
    ViewData["Title"] = "Calcular Dosis";
}

<h1>Calcular Dosis para @Model.Nombre</h1>
<p>Tipo: @Model.Tipo | Peso: @Model.Peso kg</p>

<from asp-action="Dosis" asp-route-id="@Model.Codigo" method="post">
    <div class="mb-3">
        <label for="dosisPorKg" class="from-label">Dosis por kg (mg)</label>
        <input id="dosisPorKg" name="dosisPorKg" type="number" step ="any" class="form-control"/>
        <span asp-validation-for="DosisPorKg" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Calcular</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</from>

@if (Model.DosisTotal != null)
{
    <div class="alert alert-success mt-3">
        La dosis total para <strong>@Model.Nombre</strong> es:
        <strong>@Model.DosisTotal.Value.ToString("0.00") mg</strong>
    </div>
}