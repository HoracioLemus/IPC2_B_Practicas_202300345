@model MascotaFormViewModel
@{
    bool esEdicion = !string.IsNullOrEmpty(Model.Codigo);
}

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="Tipo" class="form-label">Tipo de mascota</label>
    @if (esEdicion)
    {
        <input asp-for="Tipo" class="form-control" readonly />
    }
    else
    {
        <select asp-for="Tipo" class="form-select">
            <option value="">-- Seleccione --</option>
            <option value="Perro">Perro</option>
            <option value="Gato">Gato</option>
            <option value="Ave">Ave</option>
            <option value="Tortuga">Tortuga</option>
        </select>
    }
    <span asp-validation-for="Tipo" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Nombre" class="form-label">Nombre</label>
    <input asp-for="Nombre" class="form-control" />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Peso" class="form-label">Peso (kg)</label>
    <input asp-for="Peso" type="number" step="any" class="form-control" />
    <span asp-validation-for="Peso" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Sexo" class="form-label">Sexo</label>
    <select asp-for="Sexo" class="form-select">
        <option value="">-- Seleccione --</option>
        <option value="M">M</option>
        <option value="F">F</option>
    </select>
    <span asp-validation-for="Sexo" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Edad" class="form-label">Edad (años)</label>
    <input asp-for="Edad" type="number" class="form-control" />
    <span asp-validation-for="Edad" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Propietario" class="form-label">Propietario</label>
    <input asp-for="Propietario" class="form-control" />
    <span asp-validation-for="Propietario" class="text-danger"></span>
</div>

<div id="campo-Perro" class="mb-3 campo-tipo" style="display:none">
    <label asp-for="Raza" class="form-label">Raza</label>
    <input asp-for="Raza" class="form-control" />
    <span asp-validation-for="Raza" class="text-danger"></span>
</div>

<div id="campo-Gato" class="mb-3 campo-tipo" style="display:none">
    <div class="form-check">
        <input asp-for="Esterilizado" class="form-check-input" />
        <label asp-for="Esterilizado" class="form-check-label">¿Está esterilizado?</label>
    </div>
</div>

<div id="campo-Ave" class="mb-3 campo-tipo" style="display:none">
    <div class="form-check">
        <input asp-for="PuedeVolar" class="form-check-input" />
        <label asp-for="PuedeVolar" class="form-check-label">¿Puede volar?</label>
    </div>
</div>

<div id="campo-Tortuga" class="mb-3 campo-tipo" style="display:none">
    <label asp-for="TipoCaparazon" class="form-label">Tipo de caparazón</label>
    <input asp-for="TipoCaparazon" class="form-control" />
    <span asp-validation-for="TipoCaparazon" class="text-danger"></span>
</div>

<script>
    // Muestra solo el campo propio del tipo seleccionado
    function mostrarCampos() {
        var tipo = document.getElementById("Tipo").value;
        document.querySelectorAll(".campo-tipo").forEach(function (d) {
            d.style.display = "none";
        });
        var activo = document.getElementById("campo-" + tipo);
        if (activo) {
            activo.style.display = "block";
        }
    }
    document.getElementById("Tipo").addEventListener("change", mostrarCampos);
    mostrarCampos();
</script>