@model Mascota
@{
    ViewData["Title"] = "Detalle";
}

<h1>Detalle de @Model.Nombre</h1>

<dl class="row">
    <dt class="col-sm-3">Código</dt>
    <dd class="col-sm-9">@Model.Codigo</dd>

    <dt class="col-sm-3">Tipo</dt>
    <dd class="col-sm-9">@Model.Tipo</dd>

    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>

    <dt class="col-sm-3">Peso</dt>
    <dd class="col-sm-9">@Model.Peso kg</dd>

    <dt class="col-sm-3">Sexo</dt>
    <dd class="col-sm-9">@Model.Sexo</dd>

    <dt class="col-sm-3">Edad</dt>
    <dd class="col-sm-9">@Model.Edad años</dd>

    <dt class="col-sm-3">Propietario</dt>
    <dd class="col-sm-9">@Model.Propietario</dd>

    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@(Model.Enfermo ? "Enfermo" : "Sano")</dd>

    @if (Model is Perro perro)
    {
        <dt class="col-sm-3">Raza</dt>
        <dd class="col-sm-9">@perro.Raza</dd>
    }
    else if (Model is Gato gato)
    {
        <dt class="col-sm-3">Esterilizado</dt>
        <dd class="col-sm-9">@(gato.Esterilizado ? "Sí" : "No")</dd>
    }
    else if (Model is Ave ave)
    {
        <dt class="col-sm-3">Puede volar</dt>
        <dd class="col-sm-9">@(ave.PuedeVolar ? "Sí" : "No")</dd>
    }
    else if (Model is Tortuga tortuga)
    {
        <dt class="col-sm-3">Tipo de caparazón</dt>
        <dd class="col-sm-9">@tortuga.TipoCaparazon</dd>
    }
</dl>

<a asp-action="Index" class="btn btn-secondary">Volver</a>